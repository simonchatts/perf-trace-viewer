# This script collects scheduler and optional userspace SDT data for
# visualization. It is a standalone Bash script suitable for copying to a
# remote system.
#
# Examples:
#   ./collect 10
#   ./collect --buildid-dir /tmp/perf-cache --sdt-object /path/to/app 10

###############################################################################
# Command-line options
###############################################################################

usage()
{
    exec >&2
    if [ -n "$1" ]; then
        echo "Error: $1"
        echo
    fi
    echo "Usage: $0 [options] <time in seconds>"
    echo ""
    echo "options:"
    echo "  -h, --help           show this message and exit"
    echo "  -p, --preserve       preserve raw perf.data file"
    echo "  -c, --compressor     specify gzip compression (the only supported value)"
    echo "  -o, --other-opts     pass the additional opts to perf sched record"
    echo "      --buildid-dir    optional directory for the temporary perf cache"
    echo "      --sdt-object     ELF object whose embedded SDT probes should be recorded"
    echo "                       (may be specified more than once)"
    echo ""
    echo "For an example of -o, running:"
    echo "  $0 -o \"-C 0,2-3\" 5"
    echo "will record 5 seconds of data for only CPU cores 0, 2 and 3."
    echo ""
    echo "Save system data for later visualization using"
    echo "https://github.com/cisco-open/perf-trace-viewer"
    echo ""
    exit 1
}

# Options
preserve=0
duration=0
other_opts=""
buildid_dir=""
sdt_objects=()

# Append an SDT object while retaining whitespace in its path.
append_sdt_object()
{
    sdt_objects+=("$1")
}

process_opts()
{
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help) usage;;
            -p|--preserve) preserve=1; shift;;
            -c|--compressor)
                [ $# -ge 2 ] || usage "Missing value for $1"
                if [ "$2" != "gzip" ]; then
                    usage "Only gzip compression is supported"
                fi
                shift; shift;;
            -o|--other-opts)
                [ $# -ge 2 ] || usage "Missing value for $1"
                shift; other_opts="$1"; shift;;
            --buildid-dir)
                [ $# -ge 2 ] || usage "Missing value for $1"
                shift; buildid_dir="$1"; shift;;
            --sdt-object)
                [ $# -ge 2 ] || usage "Missing value for $1"
                shift; append_sdt_object "$1"; shift;;
            *[!0-9]*|'') usage "Invalid argument: $1";;
            *) duration="$1"; shift;;
        esac
    done
    if [ "$duration" -eq 0 ]; then
        usage 'Must provide number of seconds to record (eg 10)'
    fi
}

###############################################################################
# Process metadata
###############################################################################

# Hex-encode arbitrary bytes so paths and NUL-separated argument lists fit on
# one line in the metadata file.
hex_encode()
{
    od -An -tx1 -v | tr -d ' \n'
}

# Get process info from /proc, including the executable and full argument list.
# Each structured ## proc comment belongs to the preceding stat record. Older
# versions of the parser safely ignore these records as ordinary comments.
get_proc_info()
{
    for proc_dir in /proc/[1-9]*; do
        if [ ! -r "$proc_dir/stat" ]; then
            continue
        fi

        # Read stat first: if the process has already exited, omit the partial
        # record rather than emitting details that cannot be associated with it.
        stat=$(cat "$proc_dir/stat" 2>/dev/null) || continue
        pid=${proc_dir##*/}
        printf '%s\n' "$stat"
        printf '## proc %s ' "$pid"
        exe=$(readlink "$proc_dir/exe" 2>/dev/null) || exe=""
        printf '%s' "$exe" | hex_encode
        printf ' '
        hex_encode < "$proc_dir/cmdline" 2>/dev/null
        printf '\n'
    done
}

# Print an error message and exit
die()
{
    exec >&2
    echo ""
    echo "ERROR: $*"
    echo ""
    exit 1
}

###############################################################################
# SDT probe discovery and registration
###############################################################################

perf_sched_record_cmd="?"
sdt_cache_dir=""
sdt_event_selectors=""
sdt_probes_added=()

# Run perf using the isolated cache created for SDT discovery.
run_sdt_perf()
{
    perf --buildid-dir "$sdt_cache_dir" "$@"
}

# Return success when an SDT event is already registered in tracefs.
sdt_probe_exists()
{
    local event="$1"
    perf probe --list="$event" 2>/dev/null |
        grep -Eq "(^|[[:space:]])$event([[:space:]]|$)"
}

# Register one cached SDT event and remember ownership for cleanup.
register_sdt_probe()
{
    local event="$1"
    local probe_error

    if probe_error=$(run_sdt_perf probe --add="%$event" 2>&1); then
        sdt_probes_added+=("$event")
        return
    fi

    # Another registrar may have won the race even though this perf invocation
    # failed. Do not claim ownership of an existing event.
    if sdt_probe_exists "$event"; then
        echo "SDT event '$event' became available concurrently."
        return
    fi

    die "Could not register SDT event '$event': ${probe_error:-perf probe returned no diagnostic output.}"
}

# Add an event selector unless its provider is already being recorded.
add_sdt_event_selector()
{
    local selector="$1"

    case ",$sdt_event_selectors," in
        *",$selector,"*) return;;
    esac
    if [ -n "$sdt_event_selectors" ]; then
        sdt_event_selectors="$sdt_event_selectors,$selector"
    else
        sdt_event_selectors="$selector"
    fi
}

# Discover and register every SDT event embedded in the supplied ELF objects.
setup_sdt_probes()
{
    local cache_error
    local cache_listing
    local event
    local object
    local -a cached_sdt_events

    if [ "${#sdt_objects[@]}" -eq 0 ]; then
        return
    fi

    if [ -n "$buildid_dir" ]; then
        if ! mkdir -p "$buildid_dir"; then
            die "Could not create perf build-ID directory '$buildid_dir'."
        fi
        sdt_cache_dir=$(mktemp -d "$buildid_dir/xr-collect.XXXXXX") ||
            die "Could not create a temporary perf cache under '$buildid_dir'."
    else
        sdt_cache_dir=$(mktemp -d "${TMPDIR:-/tmp}/xr-collect.XXXXXX") ||
            die "Could not create a temporary perf cache."
    fi

    for object in "${sdt_objects[@]}"; do
        if [ ! -r "$object" ]; then
            die "SDT object '$object' is not available."
        fi
        if ! cache_error=$(run_sdt_perf buildid-cache --add "$object" 2>&1); then
            die "Could not cache SDT markers from '$object': $cache_error"
        fi
    done

    if ! cache_listing=$(run_sdt_perf probe --cache --list 2>&1); then
        die "Could not list cached SDT events: $cache_listing"
    fi
    mapfile -t cached_sdt_events < <(
        printf '%s\n' "$cache_listing" |
            sed -n 's/^\(sdt_[^:=[:space:]]*:[^=[:space:]]*\)=.*/\1/p'
    )
    if [ "${#cached_sdt_events[@]}" -eq 0 ]; then
        die "No SDT events were found in the supplied objects."
    fi

    for event in "${cached_sdt_events[@]}"; do
        if ! printf '%s\n' "$event" |
            grep -Eq '^sdt_[[:alnum:]_]+:[[:alnum:]_]+$'; then
            die "Perf returned an unsupported SDT event name '$event'."
        fi
        add_sdt_event_selector "${event%%:*}:*"
        if ! sdt_probe_exists "$event"; then
            register_sdt_probe "$event"
        fi
    done
}

# Remove temporary files and only those SDT events registered by this process.
cleanup()
{
    local event

    rm -f "$perf_script_status_file"
    for event in "${sdt_probes_added[@]}"; do
        run_sdt_perf probe --del="$event" >/dev/null 2>&1
    done
    if [ -n "$sdt_cache_dir" ]; then
        rm -rf -- "$sdt_cache_dir"
    fi
    if [ $preserve -eq 0 ]; then
        rm -f perf.data
    fi
}

###############################################################################
# Perf recording and conversion
###############################################################################

# Run perf sched record
run_perf_sched_record()
{
    # perf sched record command:
    #  --mmap-pages: use bigger buffer for less disk I/O
    #  --aio: use aync I/O if possible (not supported on old versions)
    #  sleep <n>: record system while sleep for n seconds
    cmd="perf sched record --mmap-pages 8M"
    if [ -n "$sdt_event_selectors" ]; then
        cmd="$cmd --event $sdt_event_selectors"
    fi
    if [ -z "$1" ]; then
        cmd="$cmd --aio"
    fi
    if [ -n "$NOTIFY_SOCKET" ]; then
        # perf starts its workload only after all events have been enabled.
        # Notify systemd from that workload so xr_startup.service cannot race
        # ahead of probe registration and perf recording.
        cmd="$cmd $other_opts -- $0 --notify-and-sleep $duration"
    else
        cmd="$cmd $other_opts -- sleep $duration"
    fi

    # Run perf sched record
    $cmd 2>/dev/null
    rc=$?

    # Handle exit codes
    if [ $rc -eq 139 ]; then
        echo "ERROR: 'perf sched record' hit a segmentation fault."
        echo "If you are running in a container, restart it with --privileged."
        exit 1
    fi

    if [ $rc -eq 129 ] && [ -z "$1" ]; then
        # Older versions don't support --aio (for more efficient disk usage) -
        # no need to bleat about it, just drop that option.
        run_perf_sched_record no-aio
        return
    fi
    if [ $rc -ne 0 ]; then
        die "'$cmd' failed with exit code $rc"
    fi
    perf_sched_record_cmd="$cmd"
}

perf_script_cmd=""
perf_script_output="perf.data.txt.gz"
perf_script_status_file="/run/xr-collect-perf-script-status.$$"

# Run perf script
run_perf_script()
{
    # perf script command:
    #   --show-task-events: list all processes/threads at start
    #   --fields: include pid, tid, cpu (core) number, timestamp, type of event,
    #             and event details
    #   --ns: use nanosecond resolution (not supported on old versions)
    cmd="perf script --show-task-events --fields pid,tid,cpu,time,event,trace"
    if [ -z "$1" ]; then
        cmd="$cmd --ns"
    fi

    # Stream the text through gzip instead of materializing the much larger
    # uncompressed perf.data.txt alongside perf.data.  Record perf's status
    # separately so a successful gzip cannot hide a failure from perf script.
    rm -f "$perf_script_status_file"
    (
        $cmd 2>/dev/null
        printf '%s\n' "$?" > "$perf_script_status_file"
    ) | gzip > "$perf_script_output"
    gzip_rc=$?
    if [ -r "$perf_script_status_file" ]; then
        perf_rc=$(cat "$perf_script_status_file")
        rm -f "$perf_script_status_file"
    else
        die "Could not determine the exit status of '$cmd'"
    fi
    if [ "$perf_rc" -eq 129 ] && [ "$gzip_rc" -eq 0 ] && [ -z "$1" ]; then
        # Older versions of perf don't support --ns
        run_perf_script no-ns
        return
    fi
    if [ "$gzip_rc" -ne 0 ]; then
        die "gzip failed with exit code $gzip_rc while compressing perf script output"
    fi
    if [ "$perf_rc" -ne 0 ]; then
        die "'$cmd' failed with exit code $perf_rc"
    fi
    perf_script_cmd="$cmd"
}

# Create the metadata. See `parse_mdata.py` for more format details.
create_mdata()
{
    cat <<EOF
## System performance data for https://github.com/cisco-open/perf-trace-viewer
# date: $date
# system: $uname
# duration: $duration seconds
# perf-version: $perf_version
# perf-sched-cmd: $perf_sched_record_cmd
# perf-script-cmd: $perf_script_cmd
## before
$before
## after
$after
EOF
}

###############################################################################
# Main program
###############################################################################

# Internal perf workload used by xr-collect.service.  This mode runs only after
# perf has enabled its events, making the systemd readiness notification an
# accurate indication that Process Manager can be started.
if [ "$1" = "--notify-and-sleep" ]; then
    case "$2" in
        ''|*[!0-9]*) exit 2;;
    esac
    systemd-notify --ready || exit 1
    exec sleep "$2"
fi

# Set up
filename="perf-data-$(date +%Y-%m-%d_%H-%M-%S).tar"
date=$(date)
uname=$(uname -a)
perf_version=$(perf --version)
process_opts "$@"

# Check if running as root
if [ "$(id -u)" -ne 0 ]; then
    die "This script must be run as root."
fi

# Check if perf is available
if ! which perf >/dev/null 2>&1; then
    die "The 'perf' command is not found in PATH."
fi

if ! command -v gzip >/dev/null 2>&1; then
    die "The 'gzip' command is not found in PATH."
fi

# Specific to Cisco IOS-XR: disable memdbg if present, since otherwise it can
# cause perf to coredump.
if [ "$LD_PRELOAD" = "/pkg/lib/libmemdbg.so" ]; then
    unset LD_PRELOAD
fi

# Get the "before" process info
before=$(get_proc_info)

# Make the requested SDT events available to perf sched record.
trap cleanup EXIT
setup_sdt_probes

# Record the system
echo "Collecting $duration seconds of data at $(date '+%Y-%m-%d %H:%M:%S %z')..."
run_perf_sched_record

# Get the "after" process info
after=$(get_proc_info)

# Run perf script
echo "Converting and compressing data at $(date '+%Y-%m-%d %H:%M:%S %z')..."
run_perf_script

# Create the metadata
create_mdata "$before" "$after" > perf-mdata.txt

# Create an uncompressed tar, taking care that the metadata comes first.  The
# large perf script output is already compressed inside the archive.
tar cf "$filename" perf-mdata.txt "$perf_script_output"
tar_rc=$?
if [ "$tar_rc" -ne 0 ]; then
    # Preserve every input and the partial archive for post-boot diagnosis.
    preserve=1
    die "Could not create '$filename'; tar exited with status $tar_rc."
fi
rm -f "$perf_script_output" perf-mdata.txt

# Done!
echo "Done at $(date '+%Y-%m-%d %H:%M:%S %z')!"
du -sh "$PWD/$filename"
if [ $preserve -eq 1 ]; then
    du -sh "$PWD/perf.data"
fi
